# Copy this file to .env and fill in. .env is read by the pipeline (never commit it).

# --- Image rendering (REQUIRED for real backgrounds) ---
OPENAI_API_KEY=

# --- Facebook Page publishing (optional; enables auto-post to FB on approval) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Instagram publishing ---
IG_USER_ID=
IG_TOKEN=

# --- Meta discovery token (User token; setup_meta.py fills the IDs above) ---
META_USER_TOKEN=

# --- Public image hosting for Instagram ---
# Instagram fetches the image from a public URL. Either set a static base here,
# OR configure image_host (github) in config.json and put a PAT below.
PUBLIC_IMAGE_BASE=
GITHUB_TOKEN=

# Notes:
# - Without OPENAI_API_KEY the pipeline still runs but produces a PLACEHOLDER background.
# - Facebook needs pages_manage_posts; until then it stays a manual handoff.
